# Copy to .env in the repository root. No secrets needed for the default demo.
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DATABASE_URL=sqlite:///data/state/darwix.db
# Docker Qdrant; set QDRANT_URL= to use embedded on-disk Qdrant instead.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_PATH=data/state/qdrant
QDRANT_COLLECTION=darwix_knowledge
# Optional for a secured remote Qdrant instance:
QDRANT_API_KEY=
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSIONS=512
EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=extractive
LLM_MODEL=gpt-4.1-mini
# Required only when EMBEDDING_PROVIDER or LLM_PROVIDER is openai:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
PROVIDER_TIMEOUT_SECONDS=10
RETRIEVAL_MIN_SCORE=0.3
NEAR_DUPLICATE_THRESHOLD=0.88
CHUNK_WORDS=400
CHUNK_OVERLAP_WORDS=60
TERMINOLOGY_PATH=data/fixtures/terminology.json
GOVERNMENT_ID_PATTERNS=["\\b\\d{3}-\\d{2}-\\d{4}\\b","\\b\\d{4} \\d{4} \\d{4}\\b"]
# Vite reads the root .env; this URL must be accessible from the browser.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Phase 2 keyless Windows voice demo (English only).
QUALIFICATION_RULES_PATH=data/fixtures/qualification_rules.json
ASR_PROVIDER=whisper
ASR_LANGUAGE=en-US
TTS_PROVIDER=windows
TTS_VOICE=Microsoft David Desktop
VOICE_ASR_MIN_CONFIDENCE=0.55
VOICE_MAX_TURNS=60
VOICE_AUDIO_MAX_SECONDS=20
RECORDINGS_DIR=data/audio/private

# Local English recognition; run scripts/setup_asr.py once after dependency install.
WHISPER_MODEL_NAME=small.en
WHISPER_MODEL_DIR=data/state/models/whisper-small.en
WHISPER_CPU_THREADS=2
ASR_TIMEOUT_SECONDS=30
WHISPER_MIN_SCORE=0.37
LOCALIZATION_WHISPER_MODEL_NAME=medium
LOCALIZATION_WHISPER_MODEL_DIR=data/state/models/whisper-medium
LOCALIZATION_ASR_TIMEOUT_SECONDS=60
LOCALIZATION_TTS_PROVIDER=mms
LOCALIZATION_TTS_MODEL_DIR=data/state/models/mms-tts
LOCALIZATION_TTS_TIMEOUT_SECONDS=60

# Q4: one clock-paced replay, bounded backlog and subscriber fan-out.
REALTIME_CHUNK_SECONDS=6
REALTIME_WINDOW_SECONDS=45
REALTIME_QUEUE_SIZE=3
REALTIME_MAX_SUBSCRIBERS=8
REALTIME_MIN_CONFIDENCE=0.75
REALTIME_NUDGE_EXPIRY_SECONDS=20
REALTIME_DUPLICATE_SECONDS=120
REALTIME_COOLDOWNS={"compliance_risk":15,"payment_difficulty":30,"callback_need":30,"rising_frustration":20,"missed_opportunity":30}
REALTIME_ACK_TIMEOUT_SECONDS=5
# Optional semantic classifier with LLM_PROVIDER=openai; keyless rules remain active.
REALTIME_LLM_ENABLED=false
